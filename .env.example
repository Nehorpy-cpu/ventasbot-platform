# Copiar a .env y completar. NUNCA versionar .env.

# Lo inventás vos: string aleatorio, se pega igual en la consola de Meta.
VERIFY_TOKEN=cambiar-por-un-string-aleatorio-largo

# Configuracion -> Basica -> Mostrar
APP_SECRET=

# WhatsApp -> API Setup. El de DESPUES de registrar tu numero real,
# no el del numero de prueba.
PHONE_NUMBER_ID=

# Temporal (24 h) para probar; despues el permanente del usuario del sistema.
ACCESS_TOKEN=

# Opcional, para plantillas y gestion del WABA.
WABA_ID=

# Version vigente de Graph API.
GRAPH_VERSION=v21.0

# IA local (Ollama en tu PC, gratis). No hace falta tocar esto si corrés
# Ollama con la config por defecto.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b

# Base de datos. SQLite local; en producción usar PostgreSQL.
DATABASE_URL=sqlite:///./ventasbot.db

# Autenticación del panel. Generar un valor aleatorio largo en producción.
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRE_MINUTES=480

# Superadmin inicial. Se crea ejecutando: python -m app.seed
SUPERADMIN_EMAIL=admin@ventasbot.local
SUPERADMIN_PASSWORD=cambiar-esta-clave
