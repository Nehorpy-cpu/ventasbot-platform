# Copiar a .env y completar. NUNCA versionar .env.
#
# IMPORTANTE: acá va SOLO lo de la plataforma. El número de WhatsApp y el token
# de cada empresa NO se cargan acá: los carga cada cliente desde su panel
# (Configuración -> WhatsApp) y se guardan cifrados en la base.

# --- App de Meta de la plataforma (una sola para todos los clientes) --------

# Lo inventás vos: string aleatorio, se pega igual en la consola de Meta.
VERIFY_TOKEN=cambiar-por-un-string-aleatorio-largo

# Configuracion -> Basica -> Mostrar
APP_SECRET=

# Version vigente de Graph API.
GRAPH_VERSION=v21.0

# --- IA local --------------------------------------------------------------

# Ollama en tu PC, gratis. Verificá el tag con: ollama list
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- Base de datos ---------------------------------------------------------

# SQLite local; en producción usar PostgreSQL.
# El esquema lo maneja Alembic: despues de configurar esto, correr
#   alembic upgrade head
DATABASE_URL=sqlite:///./ventasbot.db

# --- Secretos de la plataforma (obligatorios) ------------------------------

# Firma de los tokens del panel. Mínimo 32 caracteres y distinto de este
# placeholder, si no la app se niega a emitir o validar tokens.
# Generarlo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRE_MINUTES=480

# Cifra los access_token de WhatsApp que carga cada empresa. Si esta clave se
# pierde o cambia, todas las empresas tienen que volver a cargar su token.
# Generarla con: python -c "from app.cripto import generar_clave; print(generar_clave())"
ENCRYPTION_KEY=cambiar-por-una-clave-fernet-generada

# --- Superadmin inicial ----------------------------------------------------

# Se crea ejecutando: python -m app.seed
SUPERADMIN_EMAIL=admin@ventasbot.com
SUPERADMIN_PASSWORD=cambiar-esta-clave

# URL publica del servicio. Se usa para armar el link de seguimiento que se le
# manda al cliente por WhatsApp. Si queda vacia, el aviso sale sin link.
PUBLIC_BASE_URL=
